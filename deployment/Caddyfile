{
    admin off
}

{$PAPILIO_SITE_ADDRESS} {
    @upgrade expression `{http.request.scheme} == "http" && {env.PAPILIO_TRANSPORT_SCHEME} == "https"`
    redir @upgrade {env.PAPILIO_PUBLIC_ORIGIN}{uri} permanent
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
    @backend path /api/* /health/*
    handle @backend {
        reverse_proxy api:8000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
