# Required application settings
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
ADMIN_TELEGRAM_IDS=123456789
DATABASE_URL=mysql+aiomysql://papilio:change-this-password@mysql:3306/papilio
MYSQL_PASSWORD=change-this-dedicated-password
MYSQL_ROOT_PASSWORD=change-this-separate-root-password
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key-kept-outside-mysql
# Exact HTTPS origin for the owner-only web panel. Password hashes and sessions live in MySQL.
ADMIN_PUBLIC_ORIGIN=https://bot.example.com

# KPay card-to-card gateway. Keep the real API key only in the private .env.
KPAY_API_KEY=replace-with-kpay-shop-api-key
KPAY_API_BASE_URL=https://kpay.website/api/v1
# KPay login credentials and access/refresh tokens live encrypted in MySQL;
# only the Fernet key above belongs in this private environment file.
KPAY_MERCHANT_ID=replace-with-kpay-merchant-id
KPAY_SHOP_ID=replace-with-kpay-shop-uuid
KPAY_CARD_ID=replace-with-kpay-card-uuid
# Must be a public HTTPS URL once the callback server is deployed.
KPAY_CALLBACK_URL=https://bot.example.com/payments/kpay/callback
KPAY_SMS_VERIFICATION_MODE=direct
KPAY_SMS_STORE_CODE=replace-with-kpay-sms-store-code


# Marzban is intentionally a separate control-plane deployment. Do not expose
# its API publicly; point this address at the private network used by the bot.
MARZBAN_BASE_URL=http://marzban:8000
MARZBAN_USERNAME=papilio_bot
MARZBAN_PASSWORD=replace-with-long-random-password

# Customer-facing, owner-controlled subscription hostname. This is not the
# Marzban admin URL and must use HTTPS in production.
SUBSCRIPTION_PUBLIC_BASE_URL=https://sub.example.com
# Private Unix socket shared by the bot and Go/Xray controller.
XRAY_NODE_SOCKET=/run/papilio/node.sock

# Application settings
LOG_LEVEL=INFO
TIMEZONE=Asia/Tehran
ORDER_EXPIRY_MINUTES=30
TRIAL_QUOTA_BYTES=524288000
TRIAL_DURATION_HOURS=24

# Workstation-only SSH details for encrypted off-node backups. Never copy these to the VPS.
IPV4=replace-with-server-ip
SSH_USER=root
SSH_PASSWORD=replace-with-server-password
SSH_HOST_KEY_SHA256=SHA256:replace-with-pinned-host-key
