# Required application settings
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
ADMIN_TELEGRAM_IDS=123456789
DATABASE_URL=mysql+aiomysql://papilio:change-this-password@mysql:3306/papilio
MYSQL_PASSWORD=change-this-dedicated-password
MYSQL_ROOT_PASSWORD=change-this-separate-root-password
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key-kept-outside-mysql
# Exact HTTPS origin for the owner-only web panel. Password hashes and sessions live in MySQL.
ADMIN_PUBLIC_ORIGIN=https://bot.example.com

# Card details, payment methods and plans are configured in the admin panel,
# not in this bootstrap environment. Nothing is seeded by the application.

# Customer-facing, owner-controlled subscription hostname. This is not the
# Marzban admin URL and must use HTTPS in production.
SUBSCRIPTION_PUBLIC_BASE_URL=https://sub.example.com
# Private Unix socket shared by the bot and Go/Xray controller.
XRAY_NODE_SOCKET=/run/papilio/node.sock

# Application settings
LOG_LEVEL=INFO
TIMEZONE=Asia/Tehran

# Workstation-only SSH details for encrypted off-node backups. Never copy these to the VPS.
IPV4=replace-with-server-ip
SSH_USER=root
SSH_PASSWORD=replace-with-server-password
SSH_HOST_KEY_SHA256=SHA256:replace-with-pinned-host-key
